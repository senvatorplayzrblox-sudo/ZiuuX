# ---- Required ----
DISCORD_TOKEN=
CLIENT_ID=
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ziuux?retryWrites=true&w=majority
# Only ID allowed to open /botsettings and to bypass ZiuuX config-panel access checks.
# It NEVER bypasses Discord permissions or moderation hierarchy.
BOT_OWNER_ID=

# ---- AI providers (global keys; a provider without a key is simply unavailable) ----
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Optional ----
# Register slash commands to ONE guild instantly (development). Leave empty for global registration.
GUILD_ID=
# Safe to set to production on Railway (typescript is a regular dependency so the build still works).
NODE_ENV=production
LOG_LEVEL=info
# Railway sets PORT automatically; used by the /health endpoint.
PORT=3000
# Only used to seed BotSettings the very first time. Afterwards use /botsettings.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
