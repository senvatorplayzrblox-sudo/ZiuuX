{
  "name": "ziuux",
  "version": "1.0.0",
  "private": true,
  "description": "ZiuuX Discord administration bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "check": "tsc --noEmit"
  },
  "engines": { "node": ">=20.11.0" },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}